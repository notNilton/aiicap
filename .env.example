# Environment variables for AIICAP

# OpenAI API Key (for image generation)
OPENAI_API_KEY=your-openai-api-key-here

# PostgreSQL Database Configuration
# Option 1: Use full DATABASE_URL
DATABASE_URL=postgresql://username:password@localhost:5432/aiicap

# Option 2: Use individual components (if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aiicap
DB_USER=postgres
DB_PASSWORD=postgres

# Debug mode (set to 'true' to echo SQL statements)
DEBUG=false

# ===== Service Configuration =====

# Generator Service
GENERATION_DELAY=60  # Delay between generations (seconds)
SIMULATION_MODE=false  # Set to 'true' to test without API

# Corrector Service  
CORRECTION_CHECK_INTERVAL=30  # Check for new images every N seconds
CORRECTION_BATCH_SIZE=5  # Process N images per batch
